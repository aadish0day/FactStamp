rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Claim screenshots: public read so shared cards and public claim pages
    // load images; uploads require auth and must be image files ≤ 10 MB.
    match /claim_screenshots/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Everything else is locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
