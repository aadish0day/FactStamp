rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Claim screenshots: public read so shared cards and public claim pages
    // load images; uploads require auth and must be image files ≤ 10 MB.
    // Restricting to safe raster/vector formats (jpeg, png, gif, webp) to avoid SVG script-execution XSS.
    // Path is owner-scoped: the uid segment is required, so a user can only write
    // under their own prefix. The previous flat /claim_screenshots/{fileName} let
    // any signed-in user write — or silently overwrite — any other user's file.
    // NOT IN USE. Cloud Storage requires the paid Blaze plan, so screenshots are
    // stored as base64 in Firestore under `claim_media/{claimId}` instead (see
    // firestore.rules). This file is kept for the day the project moves to
    // Blaze; any future upload MUST build the path as
    // `claim_screenshots/${auth.currentUser.uid}/${fileName}`.
    match /claim_screenshots/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/gif', 'image/webp']
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Everything else is locked down by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
