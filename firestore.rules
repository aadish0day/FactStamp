rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Admin Helper ──
    // An admin is a signed-in user whose profile document has isAdmin == true.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // The seed-account allowlist that used to live here is gone. It granted
    // seven demo logins — whose shared password ships in this repo — the power
    // to forge consensus, impersonate any verifier, read every profile and wipe
    // collections. Seeding now authenticates as a real admin instead
    // (FACTSTAMP_ADMIN_EMAIL / FACTSTAMP_ADMIN_PASSWORD), so isAdmin() is the
    // only elevated path.

    // Accounts are free, so without this one person could open three and decide
    // any verdict alone. Google sign-ins arrive verified; email/password accounts
    // must click the link sent at sign-up (the client refreshes the ID token after).
    // DISABLED for now (EMAIL_VERIFICATION_REQUIRED = false in src/lib/features.ts).
    // To re-enable: return request.auth.token.email_verified == true;
    function isVerifiedEmail() {
      return true;
    }

    // The caller's own stored profile.
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verifier display names are written by the client, but `verifierId` is bound
    // to request.auth.uid — so without this a user could bypass the UI and post a
    // verdict under a real verifier's name, on a product where perceived source
    // credibility is the entire point.
    // Profiles with a blank stored displayName are exempt: the UI falls back to the
    // email prefix for those, and requiring equality would block them from posting.
    function nameMatchesCaller(name) {
      return callerProfile().get('displayName', '') == ''
        || name == callerProfile().displayName;
    }

    // The verdict a settled claim must carry: the verdict at least two of its three
    // verifiers chose, or CONTESTED on a three-way split. The client computes this,
    // so without the check the third verifier could write any verdict they liked —
    // and the reputation function pays out against it.
    function isMajorityVerdict(list, verdict) {
      return (
        (list[0].verdict == list[1].verdict || list[0].verdict == list[2].verdict)
          && verdict == list[0].verdict
      ) || (
        list[0].verdict != list[1].verdict && list[0].verdict != list[2].verdict
          && list[1].verdict == list[2].verdict
          && verdict == list[1].verdict
      ) || (
        list[0].verdict != list[1].verdict && list[0].verdict != list[2].verdict
          && list[1].verdict != list[2].verdict
          && verdict == 'CONTESTED'
      );
    }

    // Helper to verify a field's value did not change during update
    function isUnchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // Helper to check that claim identity fields did not change during update
    function identityUnchanged() {
      return isUnchanged('text')
        && isUnchanged('category')
        && isUnchanged('submittedBy')
        && isUnchanged('submittedByName')
        && isUnchanged('createdAt')
        && isUnchanged('consensusDeadline')
        && isUnchanged('consensusDeadlineMs')
        && isUnchanged('imageUrl')
        && isUnchanged('thumbnailUrl')
        && isUnchanged('hasScreenshot');
    }

    // ── Verifier Profiles ──
    match /users/{uid} {
      // Previously any signed-in user could read every profile document. Rules have
      // no field-level projection, so that exposed every user's email address and
      // isAdmin status to anyone with an account — the leaderboard's bulk read made
      // the whole collection trivially harvestable from devtools.
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());

      allow create: if request.auth != null && (
        (
          request.auth.uid == uid
          // An admin-deleted account keeps its Firebase Auth login (clients cannot
          // delete Auth users), so without this it simply recreated a fresh profile
          // on its next sign-in. No profile means no claims and no verdicts: both
          // rules read the caller's profile.
          && !exists(/databases/$(database)/documents/deleted_users/$(uid))
          && (
            (
              request.resource.data.get('reputation', 50) == 50
              && request.resource.data.get('totalVerifications', 0) == 0
              && request.resource.data.get('isAdmin', false) == false
              && request.resource.data.displayName is string
              && request.resource.data.displayName.size() <= 100
              && request.resource.data.email == request.auth.token.email
            )
          )
        ) || isAdmin()
      );

      allow update: if request.auth != null && (
        // Admin update: can manage reputation, verification count, and admin role
        (
          isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.get('reputation', 50) is int
          && request.resource.data.get('reputation', 50) >= 0
          && request.resource.data.get('reputation', 50) <= 100
          && request.resource.data.get('totalVerifications', 0) is int
          && request.resource.data.get('totalVerifications', 0) >= 0
        )
        ||
        // Self-update: the only self-edit the app makes is renaming (Profile's
        // edit-name flow and ensureProfile's sign-up race fallback both write
        // just displayName). This used to be a blocklist of immutable fields, so
        // a user could PATCH anything else onto their own doc — `role: "admin"`,
        // a rewritten createdAt, or padding up to the 1 MB document limit.
        (
          request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
        )
      );

      allow delete: if request.auth != null && isAdmin();
    }

    // ── Tombstones for admin-deleted accounts (see users create above) ──
    match /deleted_users/{uid} {
      allow read, create, delete: if request.auth != null && isAdmin();
      allow update: if false;
    }

    // ── Claims ──
    match /claims/{claimId} {
      allow read: if true;

      allow create: if request.auth != null
        && (isVerifiedEmail() || isAdmin())
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 2000
        && request.resource.data.category in ['health', 'political', 'financial', 'religious', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.verificationCount == 0
        && request.resource.data.verifications == []
        // Claims are publicly readable, so a stored reporter name told anyone who
        // reported which forward. New claims carry only the submittedBy uid (the
        // rules and "my submissions" views need it). Admin seeding is exempt: its
        // demo claims use fictional personas.
        && (isAdmin() || !('submittedByName' in request.resource.data))
        && request.resource.data.get('imageUrl', 'https://placeholder.com').matches('^(data:image/(jpeg|png|webp);base64,|https?://).*')
        && request.resource.data.get('imageUrl', '').size() <= 800000
        // Thumbnails ride along on the claim and are read by every list view,
        // so they are capped far tighter than the full screenshot.
        && request.resource.data.get('thumbnailUrl', 'https://placeholder.com').matches('^(data:image/(jpeg|png|webp);base64,|https?://).*')
        && request.resource.data.get('thumbnailUrl', '').size() <= 60000
        && (request.resource.data.submittedBy == request.auth.uid || isAdmin())
        // An admin-deleted account keeps its Auth login but has no profile; this
        // is what stops it posting (the name check that used to read the profile
        // went with submittedByName).
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        // `consensusDeadline` is an ISO string, which rules cannot parse or compare
        // to request.time — so claims also carry the same instant as epoch millis,
        // which Case B below can actually check. Without this a claim could be
        // created pre-expired and contested instantly.
        && (
          isAdmin() || (
            request.resource.data.consensusDeadlineMs is int
            && request.resource.data.consensusDeadlineMs >= request.time.toMillis()
            && request.resource.data.consensusDeadlineMs <= request.time.toMillis() + 2592000000
          )
        );

      allow update: if request.auth != null
        && (
          // Case A: Admin update (moderator consensus corrections, text edit, verdict override, seeding, flagging)
          isAdmin()
          ||
          // Case B: Consensus expiry updates (claims overdue for verification marked CONTESTED)
          (
            // Closing a claim as CONTESTED settles its public verdict, so it gets
            // the same one-person-one-vote gate as casting one.
            isVerifiedEmail()
            && identityUnchanged()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'verified'
            && request.resource.data.verdict == 'CONTESTED'
            && isUnchanged('verifications')
            && isUnchanged('verificationCount')
            && isUnchanged('adminFlagged')
            && isUnchanged('adminFlaggedAt')
            // The branch previously checked only that the claim was pending, so any
            // signed-in user could instantly close a brand-new claim as CONTESTED and
            // bury it before real verifiers saw it. Expiry now requires the claim to
            // be genuinely overdue AND short of consensus.
            && resource.data.verificationCount < 3
            // Legacy claims written before consensusDeadlineMs existed default to a
            // far-future value, so they can only be expired by an admin (Case A).
            && resource.data.get('consensusDeadlineMs', 99999999999999) <= request.time.toMillis()
            // Exactly what expireOverdueClaims writes (via updateClaimInFirestore,
            // which also stamps serverTime) and nothing else. A bare
            // status+verdict write used to pass, leaving a settled claim with no
            // confidenceScore, agreementRatio or verifiedAt for every view to trip on.
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'verdict', 'confidenceScore', 'agreementRatio', 'verifiedAt', 'serverTime'])
            && request.resource.data.confidenceScore is number
            && request.resource.data.confidenceScore >= 0
            && request.resource.data.confidenceScore <= 100
            && request.resource.data.agreementRatio is number
            && request.resource.data.agreementRatio >= 0
            && request.resource.data.agreementRatio <= 100
            && request.resource.data.verifiedAt is string
          )
          ||
          // Case C: Adding a source-backed verification
          (
            isVerifiedEmail()
            && identityUnchanged()
            && isUnchanged('adminFlagged')
            && isUnchanged('adminFlaggedAt')
            // Only open claims take verdicts. Without this a claim closed as
            // CONTESTED (fewer than 3 verifications) could be reopened by appending.
            // Deliberately no consensusDeadlineMs check: an overdue claim that is
            // still pending stays in the queue and keeps taking verdicts until it
            // reaches 3 or someone closes it through Case B.
            && resource.data.status == 'pending'
            // A claim's author cannot sit on its jury.
            && resource.data.submittedBy != request.auth.uid
            // One verifier, one verdict. Without this a single account could
            // append three verifications and manufacture a full consensus on
            // its own. Consensus closes at 3, so checking slots 0-2 (guarded by
            // the current size) covers every verification a claim can hold.
            && request.resource.data.verificationCount <= 3
            && (resource.data.verifications.size() < 1
                || resource.data.verifications[0].verifierId != request.auth.uid)
            && (resource.data.verifications.size() < 2
                || resource.data.verifications[1].verifierId != request.auth.uid)
            && (resource.data.verifications.size() < 3
                || resource.data.verifications[2].verifierId != request.auth.uid)
            // Count must increment by 1
            && request.resource.data.verificationCount == resource.data.verificationCount + 1
            // Exactly one element may be appended. hasAll() alone is a subset check,
            // so without the size bound a caller could append extra fabricated
            // verifications (any verifierId/verifierName, entirely unvalidated)
            // alongside the single element checked below, and decouple
            // verificationCount from the real array length.
            && request.resource.data.verifications.size() == resource.data.verifications.size() + 1
            && request.resource.data.verifications.hasAll(resource.data.verifications)
            // The newly appended verification element must be validated
            && request.resource.data.verifications[resource.data.verifications.size()].verifierId == request.auth.uid
            && request.resource.data.verifications[resource.data.verifications.size()].verifierReputation == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.reputation
            && request.resource.data.verifications[resource.data.verifications.size()].verdict in ['TRUE', 'FALSE', 'MISLEADING', 'UNVERIFIABLE']
            && request.resource.data.verifications[resource.data.verifications.size()].sourceUrl is string
            && request.resource.data.verifications[resource.data.verifications.size()].sourceUrl.size() <= 500
            && request.resource.data.verifications[resource.data.verifications.size()].sourceUrl.matches('^https?://.+')
            && request.resource.data.verifications[resource.data.verifications.size()].explanation is string
            && request.resource.data.verifications[resource.data.verifications.size()].explanation.size() >= 50
            && request.resource.data.verifications[resource.data.verifications.size()].explanation.size() <= 3000
            && request.resource.data.verifications[resource.data.verifications.size()].verifierName is string
            && request.resource.data.verifications[resource.data.verifications.size()].verifierName.size() <= 100
            && nameMatchesCaller(request.resource.data.verifications[resource.data.verifications.size()].verifierName)
            // status/verdict/confidenceScore used to be entirely unconstrained here, so
            // one appended verification could carry `status: 'verified'` with an
            // attacker-chosen verdict and a 99% score — forging full consensus and
            // bypassing the 3-verifier model outright. A claim may only become
            // 'verified' on the write that actually reaches 3 verifications.
            //
            // The running verdict/score are still client-computed (the client updates
            // them on every verification, not just the third); bounding them is all
            // rules can do without a trusted Cloud Function to recompute consensus.
            //
            // The running verdict on a pending claim is display-only (the reputation
            // function ignores it); the settling verdict must be the real majority.
            && (
              (
                request.resource.data.verificationCount < 3
                && request.resource.data.status == 'pending'
                && request.resource.data.verdict in ['TRUE', 'FALSE', 'MISLEADING', 'UNVERIFIABLE']
              )
              || (
                request.resource.data.verificationCount == 3
                && request.resource.data.verifications.size() == 3
                && request.resource.data.status == 'verified'
                && isMajorityVerdict(request.resource.data.verifications, request.resource.data.verdict)
              )
            )
            && request.resource.data.confidenceScore is number
            && request.resource.data.confidenceScore >= 0
            && request.resource.data.confidenceScore <= 100
          )
        );

      allow delete: if request.auth != null && isAdmin();

      // ── Verdicts subcollection ──
      match /verdicts/{verdictId} {
        allow read: if true;
        allow create: if request.auth != null
          && isVerifiedEmail()
          && request.resource.data.verifierId == request.auth.uid
          && request.resource.data.explanation is string
          && request.resource.data.explanation.size() <= 3000;
        allow update: if request.auth != null
          && resource.data.verifierId == request.auth.uid
          && isUnchanged('claimId')
          && isUnchanged('verifierId')
          && isUnchanged('createdAt')
          && request.resource.data.explanation is string
          && request.resource.data.explanation.size() <= 3000;
        allow delete: if false;
      }
    }

    // ── Claim screenshots ──
    // Cloud Storage requires the paid Blaze plan, so full screenshots are kept
    // here as base64 instead of on the claim document — list views would
    // otherwise download every image. Public read (claim pages are public);
    // only the claim's own author may attach one.
    match /claim_media/{claimId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.claimId == claimId
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches('^data:image/(jpeg|png|webp);base64,.*')
        && request.resource.data.imageUrl.size() <= 900000
        && get(/databases/$(database)/documents/claims/$(claimId)).data.submittedBy == request.auth.uid;

      // A screenshot is evidence: it is attached once and never rewritten.
      allow update: if false;
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Notifications ──
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && (request.resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        // Only allow updating isRead. All other fields must stay identical.
        && isUnchanged('type')
        && isUnchanged('title')
        && isUnchanged('message')
        && isUnchanged('createdAt')
        && isUnchanged('claimId');
      allow delete: if request.auth != null && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // ── Moderation Incident Reports ──
    match /reports/{reportId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.targetType in ['claim', 'user', 'verification']
        && request.resource.data.reason in ['misinformation_spam', 'low_quality_source', 'manipulation', 'fake_account', 'harassment', 'other']
        && request.resource.data.severity in ['low', 'medium', 'high']
        && request.resource.data.targetTitle is string
        && request.resource.data.targetTitle.size() <= 300
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 3000;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Administrative Audit Logs (Immutable) ──
    match /audit_logs/{logId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
        && isAdmin()
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 200
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
