{
  "name": "factstamp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start",
    "emulators:persist": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "seed:db": "node scripts/seed-db.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "firebase": "^12.17.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "firebase-tools": "^13.29.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.5.0",
    "vite": "^5.4.0"
  }
}
