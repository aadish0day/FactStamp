# FactStamp Environment Variables Template
# Copy this file to .env and insert your real Firebase API keys:

# Firebase Configuration (factstamp-app)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=factstamp-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=factstamp-app
VITE_FIREBASE_STORAGE_BUCKET=factstamp-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Local Emulator Suite - set to true while `npm run emulators` is running.
VITE_USE_FIREBASE_EMULATORS=false

# Dev-only: password used by the /admin gate's demo quick-fill buttons.
# Leave blank (or unset) to hide the quick-fill entirely. Never set in production.
VITE_DEMO_ADMIN_PASSWORD=

# Optional: public site URL used on share cards and link previews.
VITE_SITE_URL=https://fact-stamp.vercel.app

# Firebase App Check (reCAPTCHA v3). Leave blank to disable App Check entirely.
# Site key from https://www.google.com/recaptcha/admin (type: v3; add the
# production + preview domains and localhost). The secret key goes in the
# Firebase console, never here. Ignored while VITE_USE_FIREBASE_EMULATORS=true.
VITE_APPCHECK_SITE_KEY=
# Dev-only (`npm run dev`): a debug token registered under App Check > Apps >
# Manage debug tokens. If blank, the SDK prints a fresh token to the browser
# console on first load; register that one. Never used in production builds.
VITE_APPCHECK_DEBUG_TOKEN=
